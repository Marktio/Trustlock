{
  "name": "trustlock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=reports/unit.json",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:report": "mkdir -p reports && eslint -f json -o reports/lint.json || true",
    "audit:deps": "npm audit --audit-level=high",
    "trace": "node scripts/traceability.mjs",
    "trace:strict": "node scripts/traceability.mjs --strict",
    "evidence": "node scripts/test-results.mjs",
    "wire:db": "node scripts/wire-db.mjs",
    "wire:db:check": "node scripts/wire-db.mjs --check"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.21",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
