# Copy this file to .env.local (local) or add the same names in Vercel, Project Settings, Environment Variables.
# Never commit real keys. .env.local is git ignored.

# Clerk (who you are). Clerk dashboard, Configure, API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Supabase (where the data lives). Project Settings, API. The app uses the URL and the service role key only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, lets `npm run wire:db` apply the SQL for you. Local use only, do not add this to Vercel.
SUPABASE_ACCESS_TOKEN=

# Timed jobs (auto approval, expiry). Any random string of 16 or more characters. Keep it secret.
CRON_SECRET=

# Leave false for a real deployment. true once seeds demo contracts into an empty database.
TRUSTLOCK_SEED_DEMO=false

# Optional rate limits per minute per caller.
# RATE_LIMIT_PER_MINUTE=
# AUTH_RATE_LIMIT_PER_MINUTE=

# Developer API (/api/v1). With a database, make keys with `npm run api:key -- --label "Name of the app"`.
# Without one (demo mode, local only), set a key of your own to try the API. It is ignored in production.
# TRUSTLOCK_DEV_API_KEY=tlk_choose_any_long_random_string_here

# Upstash (all optional; without them everything still works on one server).
# Redis: makes the rate limits count across all server instances (Vercel). From the Upstash console: Redis > REST API.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# QStash: delivers webhooks to developers' servers and keeps retrying for hours. From the Upstash console: QStash.
# QSTASH_TOKEN=
# QSTASH_URL=https://qstash.upstash.io
