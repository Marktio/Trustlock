# Copy this file to .env.local and fill it in. .env.local is git-ignored; never commit real keys.
# With none of these set, TrustLock runs in demo mode (seeded accounts, data in memory).

# --- Clerk (login). Both keys are needed to turn real sign-in on. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Where Clerk sends people. These match the pages in src/app.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Supabase (database). TrustLock reads the URL and the service role key only. ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: lets `WIRE_DB.bat` apply the SQL for you (Supabase -> Account -> Access Tokens, starts sbp_). Never commit it.
SUPABASE_ACCESS_TOKEN=

# Set to true once to put the demo contracts into a brand-new, empty database.
# In demo mode (no Supabase keys) the demo data is always seeded unless this is "false".
TRUSTLOCK_SEED_DEMO=false

# --- Scheduler ---
# Secret for /api/cron/scheduler (at least 16 characters). Call it every few minutes with "Authorization: Bearer <secret>".
# Leave empty to keep the endpoint switched off. Vercel Cron sends this header automatically when CRON_SECRET is set.
CRON_SECRET=

# --- Rate limiting (optional). Defaults: 100 requests a minute per user, 10 a minute on sign-in and sign-up per address. ---
RATE_LIMIT_PER_MINUTE=
AUTH_RATE_LIMIT_PER_MINUTE=
